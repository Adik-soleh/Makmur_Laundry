{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/layanan/dry-cleaning-premium",
      "destination": "/layanan/cuci-satuan",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
